# Configuración SMTP para envío de correos
# Copia este archivo como .env y completa los valores

# Servidor SMTP (default: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (587 = TLS, 465 = SSL, 25 = sin cifrado)
SMTP_PORT=587

# Correo remitente (tu email de Gmail u otro proveedor)
SMTP_USER=tucorreo@gmail.com

# Contraseña o App Password de Gmail
# Para Gmail: genera una en https://myaccount.google.com/apppasswords
SMTP_PASS=tu_app_password_aqui

# Nombre que aparece como remitente en los correos
SMTP_FROM_NAME=Sistema Logístico
